{
  "name": "centaur",
  "private": true,
  "version": "1.2.1",
  "description": "Beginner-friendly local knowledge base agent (Tauri + LLM Wiki engine)",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* run build",
    "dev:sidecar": "pnpm --filter @wikihome/sidecar dev",
    "dev:http": "pnpm --filter @wikihome/sidecar dev:http",
    "dev:ui": "pnpm --filter @wikihome/desktop dev",
    "dev:desktop": "pnpm --filter @wikihome/desktop tauri dev",
    "test": "pnpm -r --filter=./packages/* --filter=@wikihome/desktop run test --if-present",
    "version:check": "node scripts/version-check.mjs",
    "smoke": "pnpm --filter @wikihome/sidecar smoke",
    "release:stage": "powershell -ExecutionPolicy Bypass -File scripts/stage-installer-runtime.ps1",
    "release:prepare": "powershell -ExecutionPolicy Bypass -File scripts/copy-webview2-dll.ps1",
    "release:pack": "powershell -ExecutionPolicy Bypass -File scripts/copy-release-pack.ps1"
  },
  "engines": {
    "node": ">=20"
  }
}
