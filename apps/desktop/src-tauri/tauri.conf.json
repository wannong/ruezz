{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WikiHome",
  "version": "0.1.0",
  "identifier": "app.wikihome.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WikiHome",
        "width": 1180,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
