<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store / MSIX identity for Ruezz.
  Before Partner Center submission, replace Identity Name + Publisher with the
  values shown in Partner Center → Product identity (Package/Identity/Publisher).
  Version must be four-part and increase for every Store upload (e.g. 1.2.3.0).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">
  <Identity
    Name="wannong.Ruezz"
    Publisher="CN=wannong"
    Version="1.2.3.0"
    ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Ruezz</DisplayName>
    <PublisherDisplayName>wannong</PublisherDisplayName>
    <Description>Ruezz（瑞知）— local research literature knowledge base agent</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
  </Resources>
  <Applications>
    <Application
      Id="Ruezz"
      Executable="Ruezz.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Ruezz"
        Description="Ruezz（瑞知）本地科研文献知识库 Agent"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
